# Use a production-ready PHP 8.4 + Nginx image
FROM serversideup/php:8.4-fpm-nginx

# Switch to root to install Node.js (needed for Vite/Tailwind)
USER root
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch back to the safe webuser
USER www-data

# Copy all application files
COPY --chown=www-data:www-data . /var/www/html

# Install Composer dependencies
RUN composer install --optimize-autoloader --no-dev

# Install NPM dependencies and build Tailwind/React assets
RUN npm install \
    && npm run build \
    && rm -rf node_modules

# Ensure Laravel storage permissions are correct
RUN chmod -R 775 storage bootstrap/cache